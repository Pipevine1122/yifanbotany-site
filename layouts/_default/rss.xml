{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
  <title>{{ site.Title }}</title><link>{{ .Permalink }}</link><description>{{ site.Params.description }}</description><language>{{ site.Language.LanguageCode }}</language>
  {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
  {{ $pages := .RegularPages }}{{ if .IsHome }}{{ $pages = where site.RegularPages "Section" "news" }}{{ end }}
  {{ range $pages.ByDate.Reverse }}{{ if and (not .Params.noindex) (not .Params.archive) }}<item><title>{{ .Title | markdownify | plainify }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid>{{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}<description>{{ .Summary | html }}</description></item>{{ end }}{{ end }}
</channel></rss>
